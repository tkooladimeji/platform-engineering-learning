{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["services/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
